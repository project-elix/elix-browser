# Server only. Never bundle these variables in Vite or the Windows application.
PUBLIC_URL=https://accounts.example.com
NODE_ENV=production
PORT=3210
DATABASE_PATH=./data/accounts.sqlite
AUTH_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="ELIX Browser"
# Discord is disabled until native callback binding exists; no Discord secret is used.
# Enable only behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0
