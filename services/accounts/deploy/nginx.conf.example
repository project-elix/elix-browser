# Replace accounts.example.com and certificate paths with the chosen hostname.
# Install only after DNS and the TLS certificate are ready. This is a new vhost;
# do not replace the existing ELIX website/proxy configuration.
server {
    listen 80;
    listen [::]:80;
    server_name accounts.example.com;
    return 301 https://accounts.example.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name accounts.example.com;
    ssl_certificate /etc/letsencrypt/live/accounts.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/accounts.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 6m;
    # Avoid authentication/query data in access logs.
    access_log off;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:3210;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        # Overwrite instead of appending user-supplied forwarding headers.
        # This vhost is the Internet-facing proxy, with no extra CDN/proxy ahead.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 25s;
        proxy_send_timeout 25s;
    }
}
