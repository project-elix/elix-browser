{
  "name": "elix-browser",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run && npm run test:accounts",
    "test:accounts": "node --test services/accounts/server.check.mjs services/accounts/brevo.check.mjs services/accounts/smtp.check.mjs services/accounts/deploy/install-smtp.check.mjs",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "check:release": "node scripts/validate-release.mjs",
    "version:set": "node scripts/set-version.mjs",
    "test:ui": "node tests/ui-alpha8.mjs && node tests/media-presentation.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "lucide-react": "^0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "1.62.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
